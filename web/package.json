{
  "name": "family-bike-router-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run vendor && tsc",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest run",
    "build:app": "bash scripts/assemble.sh",
    "app:sync": "npm run build:app && npx cap sync android",
    "e2e": "npm run vendor && playwright test",
    "e2e:native": "playwright test -c playwright.native.config.ts",
    "e2e:ride": "playwright test -c playwright.ride.config.ts",
    "coverage:app": "playwright test --config=playwright.coverage.config.ts --reporter=list",
    "vendor": "cp node_modules/maplibre-gl/dist/maplibre-gl.js node_modules/maplibre-gl/dist/maplibre-gl.css .",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.61.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "maplibre-gl": "^4.7.1",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.4.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2"
  }
}
